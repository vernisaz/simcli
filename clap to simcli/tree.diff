diff --git a/src/rust_tree/mod.rs b/src/rust_tree/mod.rs
index 76c0ea4..5ea5c39 100644
--- a/src/rust_tree/mod.rs
+++ b/src/rust_tree/mod.rs
@@ -6,3 +6,66 @@ pub mod icons;
 pub mod options;
 pub mod traversal;
 pub mod utils;
+
+use std::path::Path;
+
+pub struct MatchOptions {
+    case_sensitive: bool,
+    #[allow(unused)]
+    require_literal_separator: bool,
+    #[allow(unused)]
+    require_literal_leading_dot: bool,
+}
+
+#[derive(Clone)]
+pub struct Pattern {
+    pub before: Option<String>,
+    pub after: String,
+}
+
+impl Pattern {
+    pub fn new(s: &str) -> Self {
+        if let Some((before, after)) = s.split_once('*') {
+            Pattern {
+                before: Some(before.to_string()),
+                after: after.to_string(),
+            }
+        } else {
+            Pattern {
+                before: None,
+                after: s.to_string(),
+            }
+        }
+    }
+    pub fn matches(&self, s: &str) -> bool {
+        if let Some(before) = &self.before
+            && s.starts_with(before)
+            && s.ends_with(&self.after)
+        {
+            true
+        } else {
+            self.before.is_none() && s == self.after
+        }
+    }
+
+    pub fn matches_path_with(&self, p: &Path, options: &MatchOptions) -> bool {
+        let s = if options.case_sensitive {
+            p.display().to_string()
+        } else {
+            p.display().to_string().to_ascii_lowercase()
+        };
+        if options.case_sensitive {
+            self.matches(&s)
+        } else {
+            if let Some(before) = &self.before
+                && let before = before.to_ascii_lowercase()
+                && s.starts_with(&before)
+                && s.ends_with(&self.after.to_ascii_lowercase())
+            {
+                true
+            } else {
+                self.before.is_none() && s == self.after.to_ascii_lowercase()
+            }
+        }
+    }
+}
